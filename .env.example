# Environment Mode: 'development' or 'production'
ENV=development

# Upstream Backend API Configuration
CROSSWALK_API_URL=http://127.0.0.1:8000
# Backend Service API Key (>= 32 chars in production)
CROSSWALK_API_KEY=

# Document Workspace Session & Context Signing Secret (>= 32 chars in production)
# Used to sign session cookies, CSRF tokens, and gateway-to-backend X-Workspace-Context assertions.
WORKSPACE_SESSION_SECRET=

# Server-Bound Tenant Context
BANKING_CROSSWALK_TENANT_ID=local-workspace

# Optional: Local Loopback Auth Bypass (Non-production only, binds to 127.0.0.1/localhost)
ALLOW_LOCAL_DEV_AUTH_BYPASS=false

# Optional: Built-in Self-Hosted Account Registry (JSON array)
# When omitted in non-production, standard local accounts (analyst, reviewer, viewer, admin) are provided.
# In production, accounts MUST provide salted 'password_hash' (generate with: node scripts/hash_password.js <password>).
# Plaintext 'password' or unsalted 'password_sha256' are strictly rejected in production.
# Example: [{"user_id":"usr-1","username":"reviewer","display_name":"Senior Reviewer","password_hash":"scrypt$...","tenants":{"local-workspace":["reviewer"]}}]
WORKSPACE_USERS_JSON=

# Optional: Durable Session Revocation Path (defaults to system tmp: /tmp/crosswalk_revocations.json)
# Used to persist logout and revoked sessions across process restarts and multi-worker gateways.
SESSION_REVOCATION_PATH=

# Enterprise OpenID Connect (OIDC) / OAuth2 with PKCE (Experimental — non-production only)
# Hosted production disables custom OIDC callback pending standards-compliant IDP exchange.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Optional: Server-to-server static bearer token for workspace automation
# Restricted to read-only 'viewer' permissions; cannot review clauses, mappings, or create baselines.
WORKSPACE_AUTH_TOKEN=

# Allowed CORS Origins
ALLOWED_ORIGINS=http://localhost:3000

# Storage & Persistence
ALLOW_EPHEMERAL_CROSSWALK=false
DATABASE_URL=

# compose.postgres.yaml credentials: generate TWO different URL-safe passwords
POSTGRES_PASSWORD=
CROSSWALK_DATABASE_PASSWORD=
