ENV=development
CROSSWALK_API_URL=http://127.0.0.1:8000
# Generate your own strong key before exposing the API beyond localhost.
CROSSWALK_API_KEY=
BANKING_CROSSWALK_TENANT_ID=public-demo
# Trusted-service reviewer identity, required for production review routes.
BANKING_CROSSWALK_ACTOR=
BANKING_CROSSWALK_ROLE=
ALLOWED_ORIGINS=http://localhost:3000
ALLOW_EPHEMERAL_CROSSWALK=false
# Optional PostgreSQL. Install backend[postgres] and migrate before API startup.
# Export a URL to a non-owner runtime role. Never commit real credentials.
DATABASE_URL=
# compose.postgres.yaml only: generate TWO different URL-safe passwords.
POSTGRES_PASSWORD=
CROSSWALK_DATABASE_PASSWORD=
