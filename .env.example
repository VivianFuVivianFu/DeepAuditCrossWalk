# Environment Mode: 'development' or 'production'
ENV=development

# Upstream Backend API Configuration
CROSSWALK_API_URL=http://127.0.0.1:8000
# Backend Service API Key (>= 32 chars in production)
CROSSWALK_API_KEY=

# Document Workspace Session & Context Signing Secret (>= 32 chars in production)
# Used to sign session cookies, CSRF tokens, and gateway-to-backend X-Workspace-Context assertions.
WORKSPACE_SESSION_SECRET=

# Server-Bound Tenant Context
BANKING_CROSSWALK_TENANT_ID=local-workspace

# Optional: Local Loopback Auth Bypass (Non-production only, binds to 127.0.0.1/localhost)
ALLOW_LOCAL_DEV_AUTH_BYPASS=false

# Optional: Built-in Self-Hosted Account Registry (JSON array)
# When omitted in non-production, standard local accounts (analyst, reviewer, viewer, admin) are provided.
# Example: [{"user_id":"usr-1","username":"analyst","password":"secret","tenants":{"local-workspace":["analyst"]}}]
WORKSPACE_USERS_JSON=

# Optional: Enterprise OpenID Connect (OIDC) / OAuth2 with PKCE
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Optional: Server-to-server static bearer token for workspace automation
WORKSPACE_AUTH_TOKEN=

# Allowed CORS Origins
ALLOWED_ORIGINS=http://localhost:3000

# Storage & Persistence
ALLOW_EPHEMERAL_CROSSWALK=false
DATABASE_URL=

# compose.postgres.yaml credentials: generate TWO different URL-safe passwords
POSTGRES_PASSWORD=
CROSSWALK_DATABASE_PASSWORD=
